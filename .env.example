NODE_ENV=development
PORT=3000
APP_NAME=LKX
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Web configuration (public values; returned by /api/config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK credentials. Keep the service account file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Generate with: node --input-type=commonjs -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ACCESS_SESSION_SECRET=

